import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import silhouette_score
from sklearn.metrics import pairwise_distances, pairwise_distances_argmin

# Load dataset directly from URL
url = "https://raw.githubusercontent.com/RAHULKASHYAP02/Credit-Card-Segmentation/master/CC%20GENERAL.csv"

df = pd.read_csv(url)

print("First five records:")
print(df.head())

print("\nDataset Shape:")
print(df.shape)

# Remove customer ID
X = df.drop(columns=["CUST_ID"], errors="ignore")

# Select numerical columns
X = X.select_dtypes(include=np.number)

# Handle missing values
X = SimpleImputer(strategy="median").fit_transform(X)

# Feature scaling
X = StandardScaler().fit_transform(X)

# Use a sample to make K-Medoids faster
rng = np.random.default_rng(42)
sample_size = min(1500, len(X))
sample_indices = rng.choice(len(X), sample_size, replace=False)

X_sample = X[sample_indices]

# K-Medoids implementation using alternate updates
def k_medoids(X, k, max_iter=30, random_state=42):

    rng = np.random.default_rng(random_state)

    # Calculate distance matrix
    distances = pairwise_distances(X, metric="euclidean")

    # Randomly select initial medoids
    medoids = rng.choice(len(X), k, replace=False)

    for iteration in range(max_iter):

        # Assign points to nearest medoid
        labels = np.argmin(distances[:, medoids], axis=1)

        old_medoids = medoids.copy()

        # Update medoids
        for cluster in range(k):

            members = np.where(labels == cluster)[0]

            if len(members) == 0:
                continue

            cluster_distances = distances[np.ix_(members, members)]

            total_distances = cluster_distances.sum(axis=1)

            medoids[cluster] = members[np.argmin(total_distances)]

        if np.array_equal(old_medoids, medoids):
            break

    labels = np.argmin(distances[:, medoids], axis=1)

    return medoids, labels


# Calculate Silhouette Scores
scores = []
K = range(2, 7)

for k in K:

    medoids, labels = k_medoids(
        X_sample, k, random_state=42
    )

    score = silhouette_score(
        X_sample,
        labels,
        sample_size=min(1000, len(X_sample)),
        random_state=42
    )

    scores.append(score)

    print("K =", k, "Silhouette Score =", round(score, 4))


# Find optimal number of clusters
best_k = list(K)[np.argmax(scores)]

print("\nOptimal Number of Clusters:", best_k)


# Plot Silhouette Scores
plt.plot(list(K), scores, marker="o")

plt.xlabel("Number of Clusters (K)")
plt.ylabel("Silhouette Score")
plt.title("Silhouette Method - K-Medoids")

plt.show()


# Final model using the sample
medoids, sample_labels = k_medoids(
    X_sample, best_k, random_state=42
)

# Assign all customers to their nearest medoid
df["Cluster"] = pairwise_distances_argmin(
    X, X_sample[medoids]
)

# Display cluster counts
print("\nCluster Counts:")
print(df["Cluster"].value_counts().sort_index())

# Display sample results
print("\nSample Results:")
print(df[["CUST_ID", "Cluster"]].head())
